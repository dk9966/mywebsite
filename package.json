{
  "name": "mywebsite-temp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:site": "SITE_ONLY=1 vite build",
    "deploy:site": "vercel build --prod --yes && vercel deploy --prebuilt --prod --yes",
    "lint": "eslint .",
    "preview": "vite preview",
    "capture-site-gif": "tsx scripts/capture-site-gif.ts",
    "capture-artefakt-gif": "tsx scripts/capture-site-gif.ts --url https://artefakt.mov/ --out plans/assets/artefakt-mov-capture.gif",
    "extract-video-frames": "tsx scripts/extract-video-frames.ts",
    "watch-clip-titles": "tsx scripts/watch-clip-titles.ts",
    "render-circuit-flow": "node scripts/render-circuit-flow.mjs",
    "render-circuit-board": "node scripts/render-circuit-board.mjs",
    "render-circuit-board:dense": "node scripts/render-circuit-board.mjs --variant dense-long",
    "render-circuit-road": "node scripts/render-circuit-road.mjs",
    "render-circuit-pcb": "node scripts/render-circuit-pcb.mjs",
    "trace-reference-lines": "node scripts/trace-reference-lines.mjs",
    "build-circuits-tracing": "python3 scripts/build-circuits-tracing-snapshot.py",
    "build-component-reference-outline": "python3 scripts/build-component-reference-outline-glb.py",
    "export-board-spatial": "tsx scripts/export-board-spatial.ts",
    "export-mesh-variant-catalog": "tsx scripts/export-mesh-variant-catalog.ts",
    "insert-circuit-mesh": "tsx scripts/insert-circuit-mesh.ts",
    "check-circuit-line-geometry": "tsx scripts/check-circuit-line-geometry.ts",
    "export-secret-base-world": "node secret-base/scripts/export-world.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "gsap": "^3.14.2",
    "opentype.js": "^1.3.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "skeleton-tracing-js": "^1.0.4",
    "three": "^0.183.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright": "^1.59.1",
    "seedrandom": "^3.0.5",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}