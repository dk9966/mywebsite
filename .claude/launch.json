{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "world-viewer",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8080"
      ],
      "port": 8080
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5174
    },
    {
      "name": "site-5175",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "voxel-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "voxel-server"
      ],
      "port": 4100
    }
  ]
}
